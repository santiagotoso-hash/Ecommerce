{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "jsx": "react-jsx",
    "checkJs": false,
    "experimentalDecorators": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strict": true,
    "incremental": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "**/node_modules/*"]
}
